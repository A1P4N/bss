# ═══════════════════════════════════════════════════════════════
# BSS — environment variables template
# ═══════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to Git.

# ── Source API credentials ───────────────────────────────────
# Binance (or other exchange API keys)
BSS_SOURCE_API_KEY=
BSS_SOURCE_API_SECRET=

# ── Logging ──────────────────────────────────────────────────
BSS_LOG_LEVEL=INFO

# ── Path overrides ───────────────────────────────────────────
# Uncomment to override the default data directory.
# BSS_DATA_DIR=data